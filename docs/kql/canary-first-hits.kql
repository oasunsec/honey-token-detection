CanaryHit_CL
| where TimeGenerated > ago(24h)
| where EventType == "canary_trigger"
| where FirstHit == true
| project TimeGenerated, EventTime, EventId, CanaryId, ArtifactName, SourceIp, UserAgent, Classification, Severity, IsScanner, IsDuplicate, FirstHit, RepeatCount, AlertStatus, Reason, ReceiverVersion
| order by TimeGenerated desc
