    },
    "entityMappings": [
      {
        "entityType": "IP",
        "fieldMappings": [
          {
            "columnName": "SourceIp",
            "identifier": "Address"
          }
        ]
      }
    ],
    "eventGroupingSettings": {
      "aggregationKind": "AlertPerResult"
    }
